# ---- Database + private image storage (Supabase) ----
SUPABASE_URL=https://xxxx.supabase.co
# Server-only. Never prefix with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
token_BUCKET=token-images

# ---- Admin notification email (Resend) ----
RESEND_API_KEY=re_xxx
# Without a verified domain, keep onboarding@resend.dev (Resend only delivers to the email your Resend account was created with).
MAIL_FROM=TicketBuddy <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=emmanuelabioye67@gmail.com

# ---- Admin sign-in (for #/admin) ----
ADMIN_PASSWORD=choose-a-long-password
ADMIN_SESSION_SECRET=at-least-32-random-characters

# ---- Public site URL, used for the link inside the admin email ----
SITE_URL=https://your-site.vercel.app
